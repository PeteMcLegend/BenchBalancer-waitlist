<div class="page">
  <header class="topbar">
    <div class="brand">
      <div class="logo-mark">
        <img src="{{ 'benchbalancer-logo-mark.png' | asset_url }}" alt="BenchBalancer logo">
      </div>
      <div class="brand-text">
        <p class="brand-name">BenchBalancer</p>
        <p class="brand-tag">Smarter bench, smarter game</p>
      </div>
    </div>
    <a class="button pill header-cta" href="#waitlist">Join the waitlist</a>
  </header>

  <main>
    <section class="hero" id="top">
      <div class="hero-copy">
        <h1>BenchBalancer</h1>
        <p class="lede">Smart, simple rotation tracking so you stop juggling paper charts, stopwatches, and sideline pressure. Parents see the receipts, coaches stay calm.</p>
        <div class="hero-ctas">
          <a class="button" href="#waitlist">Join the waitlist</a>
        </div>
        <div class="badges">
          <span class="badge">Equal minutes</span>
          <span class="badge">Zero parent drama</span>
          <span class="badge">Coach-proof simple</span>
        </div>
        <div class="trust-note">Instant confirmation. No spam, just launch updates.</div>
      </div>
      <div class="hero-visual">
        <div class="glass">
          <div class="phone-slider">
            <img src="{{ 'phone-3.png' | asset_url }}" alt="BenchBalancer mobile dashboard screen 3" class="active" loading="lazy">
            <img src="{{ 'thatphone-4.png' | asset_url }}" alt="BenchBalancer mobile dashboard screen 4" loading="lazy">
            <img src="{{ 'phone-5.png' | asset_url }}" alt="BenchBalancer mobile dashboard screen 5" loading="lazy">
            <img src="{{ 'phone-6.png' | asset_url }}" alt="BenchBalancer mobile dashboard screen 6" loading="lazy">
            <img src="{{ 'phone-7.png' | asset_url }}" alt="BenchBalancer mobile dashboard screen 7" loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <section class="highlights" id="product">
      <div class="section-head">
        <p class="eyebrow">Why BenchBalancer</p>
        <h2>Fair, fast, stress-free rotations for youth teams.</h2>
        <p class="section-lede">Purpose-built for coaches of kids 5-12 to keep playtime balanced, calm the sidelines, and make subs make sense across any sport.</p>
      </div>
      <div class="card-grid">
        <article class="card">
          <p class="card-tag">01</p>
          <h3>Balance rotations instantly</h3>
          <p>Auto-track who played, who's next, and keep minutes equal without juggling timers or paper.</p>
        </article>
        <article class="card">
          <p class="card-tag">02</p>
          <h3>Zero parent drama</h3>
          <p>Show live minutes to answer "Why isn't my kid playing more?" with data, not debates.</p>
        </article>
        <article class="card">
          <p class="card-tag">03</p>
          <h3>Coach-proof simple</h3>
          <p>Volunteer, rookie, or tired coach? One-tap subs and automated fairness keep it consistent every week.</p>
        </article>
      </div>
    </section>

    <section class="cta" id="waitlist">
      <div class="cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Join the waitlist</p>
          <h2>Join the waitlist for BenchBalancer's launch.</h2>
          <p class="section-lede">Drop your email to lock a spot. We will confirm instantly and keep you updated as we roll out BenchBalancer for youth team sports.</p>
          <ul class="list">
            <li>No spam, ever.</li>
            <li>Built for youth coaches, parents, and clubs.</li>
            <li>Launch insights, early demos, and product drops.</li>
          </ul>
        </div>
        {% form 'customer', id: 'waitlist-form', novalidate: true %}
          <label class="field">
            <span>Email</span>
            <input type="email" name="contact[email]" required placeholder="you@example.com" aria-label="Email address">
            <input type="hidden" name="contact[tags]" value="waitlist">
          </label>
          <button class="button full" type="submit">Join the waitlist</button>
          {% if form.posted_successfully? %}
            <p class="form-status">You are on the waitlist. We will be in touch soon.</p>
          {% elsif form.errors %}
            <p class="form-status error">{{ form.errors | default_errors }}</p>
          {% endif %}
          <p class="privacy">By joining, you agree to receive BenchBalancer updates. You can opt out anytime.</p>
        {% endform %}
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="brand">
      <div class="logo-mark">
        <img src="{{ 'benchbalancer-logo-mark.png' | asset_url }}" alt="BenchBalancer logo">
      </div>
      <div class="brand-text">
        <p class="brand-name">BenchBalancer</p>
        <p class="brand-tag">Smarter bench, smarter game</p>
      </div>
    </div>
    <p class="footer-note">Performance analytics and balanced rotations built for modern youth sports culture.</p>
    <a class="link" href="#waitlist">Join waitlist</a>
  </footer>
</div>

<div class="mobile-stick">
  <a class="button full" href="#waitlist">Join the waitlist</a>
</div>

<script>
  const sliderImages = document.querySelectorAll('.phone-slider img');

  if (sliderImages.length) {
    let currentSlide = 0;
    const cycleSlides = () => {
      sliderImages[currentSlide].classList.remove('active');
      currentSlide = (currentSlide + 1) % sliderImages.length;
      sliderImages[currentSlide].classList.add('active');
    };
    setInterval(cycleSlides, 2500);
  }
</script>
